{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch file",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}"
    },
    {
      "name": "WebSocketsChat: Phase 1 Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/WebsocketsChat/phase1",
      "cwd": "${workspaceFolder}/advanced-programs/WebsocketsChat",
      "args": [
        "-addr",
        ":8080"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/WebsocketsChat/.gocache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Vehicle Lifecycle: Generate/Validate/Features",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/cmd/vehicle-lifecycle",
      "cwd": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle",
      "args": [
        "all",
        "-rows",
        "500"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.gocache",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.uv-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Vehicle Lifecycle: Custom Telemetry Orchestrator",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/cmd/vehicle-lifecycle",
      "cwd": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle",
      "args": [
        "orchestrate",
        "-config",
        "configs/pipeline.json",
        "-rows",
        "500"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.gocache",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.uv-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Vehicle Lifecycle: Perception DVC Manifest",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/cmd/vehicle-lifecycle",
      "cwd": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle",
      "args": [
        "orchestrate",
        "-config",
        "configs/perception-dvc.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.gocache",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.uv-cache",
        "DVC_SITE_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.dvc/site-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Vehicle Lifecycle: Segmentation Training Smoke",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/cmd/vehicle-lifecycle",
      "cwd": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle",
      "args": [
        "orchestrate",
        "-config",
        "configs/perception-training.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.gocache",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.uv-cache",
        "DVC_SITE_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.dvc/site-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Vehicle Lifecycle: Segmentation Training Full W&B",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/cmd/vehicle-lifecycle",
      "cwd": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle",
      "args": [
        "orchestrate",
        "-config",
        "configs/perception-training-full-wandb.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.gocache",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.uv-cache",
        "DVC_SITE_CACHE_DIR": "${workspaceFolder}/advanced-programs/GrafanaSensorVisualization/vehicle-lifecycle/.dvc/site-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Predictor Go: Validate Samples",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/predictor-go/cmd/predictorctl",
      "cwd": "${workspaceFolder}/advanced-programs/predictor-go",
      "args": [
        "validate-samples"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Predictor Go: Replay Samples Stdout",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/predictor-go/cmd/predictorctl",
      "cwd": "${workspaceFolder}/advanced-programs/predictor-go",
      "args": [
        "replay-samples",
        "-sink",
        "stdout"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Predictor Go: Replay Samples Redis",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/predictor-go/cmd/predictorctl",
      "cwd": "${workspaceFolder}/advanced-programs/predictor-go",
      "args": [
        "replay-samples",
        "-sink",
        "redis",
        "-redis-url",
        "redis://localhost:6379/0"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Predictor Go: Instrument Orchestrator",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/predictor-go/cmd/instrument-orchestrator",
      "cwd": "${workspaceFolder}/advanced-programs/predictor-go",
      "args": [
        "-config",
        "configs/btc-instruments.sample.json"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Predictor Go: Writer Redis to Parquet",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/predictor-go/cmd/predictor-writer",
      "cwd": "${workspaceFolder}/advanced-programs/predictor-go",
      "args": [
        "-redis-url",
        "redis://localhost:6379/0",
        "-sink",
        "parquet",
        "-parquet-dir",
        "output/orderbooks",
        "-metrics-addr",
        ":8080"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 01: Inspect Fixture",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/cmd/inspect-sample",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "args": [
        "-config",
        "configs/nuscenes-mini.fixture.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.gocache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 02-03: Ingest Fixture",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/cmd/ingest",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "args": [
        "-config",
        "configs/nuscenes-mini.fixture.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.gocache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 04: Query Fixture Lake",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/cmd/query-demo",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "args": [
        "-lake",
        "runs/ci/lake"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.gocache",
        "PYTHONPATH": "python",
        "UV_CACHE_DIR": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.uv-cache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 05: Build Manifest Fixture",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/cmd/build-manifest",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "args": [
        "-config",
        "configs/nuscenes-mini.fixture.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.gocache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 05: Build Parquet Manifest Fixture",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/cmd/build-parquet-manifest",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "args": [
        "-config",
        "configs/nuscenes-mini.fixture.json"
      ],
      "env": {
        "GOCACHE": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.gocache"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 05: Train Loader Fixture",
      "type": "debugpy",
      "request": "launch",
      "module": "training_loader.demo",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "python": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.venv/bin/python",
      "args": [
        "--manifest",
        "runs/ci/manifests/training_manifest.jsonl"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/python"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "nuScenes Lesson 05: Train Parquet Loader Fixture",
      "type": "debugpy",
      "request": "launch",
      "module": "training_loader.demo",
      "cwd": "${workspaceFolder}/advanced-programs/nuscenes-data-platform",
      "python": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/.venv/bin/python",
      "args": [
        "--parquet-manifest",
        "runs/ci/lake/training/training_manifest_v2.parquet"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/advanced-programs/nuscenes-data-platform/python"
      },
      "console": "integratedTerminal"
    }
  ]
}
REDIS_URL=redis://redis:6379/0
RAW_REDIS_STREAM=orderbook.raw.v1
NORMALIZED_REDIS_STREAM=orderbook.normalized.v1
REDIS_CONSUMER_GROUP=predictor-go-writers
PREDICTOR_SINK=parquet
PARQUET_OUTPUT_DIR=/data/orderbooks
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=orderbooks
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
